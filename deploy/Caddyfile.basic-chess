# Blocco da AGGIUNGERE al Caddyfile della VPS (/etc/caddy/Caddyfile), accanto a quelli
# degli altri progetti: non li sostituisce.
#
# A differenza degli altri progetti su questa macchina qui NON c'e' nessun processo da
# proxare: l'applicazione e' un sito statico e tutto il calcolo (Stockfish) avviene nel
# browser di chi gioca. Niente backend, niente porta, niente systemd.
#
# Nessun header COOP/COEP: usiamo la build single-thread di Stockfish, che non ha
# bisogno di SharedArrayBuffer (vedi src/engine/browserTransport.ts).
#
# L'indirizzo e' grandmachess.com, dominio proprio e non piu' un sottodominio. Il
# vecchio scacchi.riccardopaulin.com non e' piu' servito: non c'e' nessun blocco per
# lui, e Caddy a quel punto non risponde affatto su quel nome.
#
# Il dominio NUDO e' un record A verso l'IP della VPS, e non puo' essere altrimenti:
# la radice di una zona DNS deve poter portare i propri NS e SOA, e un CNAME li
# escluderebbe. Il www invece e' un CNAME verso il dominio nudo, e da qui viene
# rimandato con un 301 sul nome senza www: un indirizzo solo, non due.

grandmachess.com {
	root * /srv/basic-chess/dist
	encode zstd gzip

	# I file in assets/ hanno l'hash del contenuto nel nome: cambiano nome ad ogni
	# build, quindi si possono tenere in cache per sempre.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# Motore (7 MB) e dizionario delle aperture (340 KB) NON hanno l'hash nel nome, ma
	# cambiano solo quando si aggiorna Stockfish o il dataset ECO: una settimana di
	# cache evita di riscaricarli ad ogni visita senza incastrare nessuno a lungo.
	header /engine/* Cache-Control "public, max-age=604800"
	header /openings.json Cache-Control "public, max-age=604800"

	# HSTS: il browser che ha visto questa intestazione non prova nemmeno piu' a
	# chiedere il sito in chiaro. Serve a chi scrive "grandmachess.com" senza
	# prefisso, che altrimenti parte in http e ci arriva solo dopo un 308.
	#
	# max-age di UN GIORNO e non di un anno, ed e' una scelta prudente e non una
	# svista. L'intestazione e' vincolante per il browser che l'ha ricevuta: finche'
	# vale, un certificato rotto non e' piu' aggirabile con "procedi comunque" e il
	# sito diventa irraggiungibile invece che brutto, e servire il dominio in http
	# semplice (un parcheggio, un hosting di passaggio) non funziona piu'. Con un
	# giorno l'effetto pratico c'e' tutto e l'impegno si esaurisce da solo.
	#
	# Niente includeSubDomains: vincolerebbe anche sottodomini che non esistono
	# ancora, e non sappiamo cosa ci metteremo. Niente preload: quello si toglie in
	# mesi, non in un giorno.
	header Strict-Transport-Security "max-age=86400"

	# La foto della nonna, e in generale i file che NON stanno nel repository.
	#
	# Sono fuori da dist/ apposta, per tre ragioni che si sommano: dist/ viene
	# cancellata e ricreata ad ogni pubblicazione, quindi qualunque cosa ci si metta
	# a mano sparisce; il repository e' pubblico e sotto GPL, e una fotografia di
	# famiglia non deve finire nei cloni ne' sotto quella licenza; e servendola dallo
	# STESSO dominio non ci sono contenuti misti ne' richieste a terzi, che e' la
	# stessa regola che ci siamo dati per tutto il resto.
	handle_path /static/* {
		root * /srv/basic-chess/static
		header Cache-Control "public, max-age=604800"
		file_server
	}

	file_server
}

# Il www non serve una seconda copia del sito: rimanda al nome canonico. Un solo
# indirizzo vero significa anche una sola partita salvata, perche' quella vive nel
# localStorage del browser ed e' legata al dominio esatto.
www.grandmachess.com {
	redir https://grandmachess.com{uri} permanent
}
