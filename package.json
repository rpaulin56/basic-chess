{
  "name": "basic-chess",
  "version": "0.1.0",
  "description": "Scacchiera didattica con tutor: gioco contro bot calibrato e analisi degli errori",
  "private": true,
  "author": "Riccardo Paulin",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-engine.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "calibrate": "tsx scripts/calibrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "review": "tsx scripts/review.ts",
    "explain": "tsx scripts/explain.ts",
    "botprobe": "tsx scripts/botprobe.ts"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  }
}